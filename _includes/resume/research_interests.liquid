<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.name }}</h6>
      {% if content.summary %}
        <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.summary }}</h6>
      {% endif %}
      {% if content.keywords and content.keywords.size > 0 %}
        <ul class="items">
          {% for item in content.keywords %}
            <li><span class="item">{{ item }}</span></li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
